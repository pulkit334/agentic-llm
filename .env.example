# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=followup_agent

# --- Email ---
# mock = save to the outbox table only (safe for demo)
# smtp = really send through the SMTP server below
EMAIL_MODE=mock

# Gmail example: host smtp.gmail.com, port 587,
# user = your Gmail address, pass = a 16-char Google "App Password"
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Safety net while testing: if set, every real email goes to this address instead
SMTP_REDIRECT_TO=

# --- Reply detection (IMAP) ---
# `python -m followup.imap_sync --days 7` pulls replies from known contacts into the DB.
# Logs in with SMTP_USER / SMTP_PASS (a Gmail App Password works for IMAP as well).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
