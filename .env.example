# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=followup_agent

# --- Email ---
# mock = save to the outbox table only (safe for demo)
# smtp = really send through the SMTP server below
EMAIL_MODE=mock

# Gmail example: host smtp.gmail.com, port 587 (STARTTLS) or 465 (SSL),
# user = your Gmail address, pass = a 16-char Google "App Password"
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# MAIL_USER / MAIL_PASS / MAIL_FROM / MAIL_HOST / MAIL_PORT / MAIL_REDIRECT_TO work as aliases.
# Where replies should go (defaults to SMTP_FROM)
SMTP_REPLY_TO=
# Safety net while testing: if set, every real email goes to this address instead
SMTP_REDIRECT_TO=
# Check the setup: python -m followup.cli test-email --to you@example.com

# --- Reply detection (IMAP) ---
# `python -m followup.cli sync-replies --days 7` pulls replies from known contacts into the DB.
# In smtp mode the scheduler also syncs replies automatically before sending due follow-ups.
# Logs in with SMTP_USER / SMTP_PASS (a Gmail App Password works for IMAP as well).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
